# ============================================
# 实时竞拍大师 — 生产环境变量
# ============================================
# 复制本文件为 .env.production 并修改配置
#   cp .env.production.example .env.production
# ============================================

# --- 数据库 ---
DB_PASSWORD=请修改为安全密码
DB_NAME=auction_master
DB_USER=root

# --- Redis ---
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=请修改为随机字符串（openssl rand -hex 32）
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=168h

# --- 上传 ---
MAX_UPLOAD_SIZE_MB=10
